<Application x:Class="Kerlo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="BaseBrush" Color="#0B1119"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#111923"/>
    <SolidColorBrush x:Key="CardBrush" Color="#18222D"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#293543"/>
    <SolidColorBrush x:Key="TextBrush" Color="#EEF4F4"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#93A4AF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#9BDACB"/>
    <SolidColorBrush x:Key="FaintBrush" Color="#263740"/>
    <Style TargetType="Window">
      <Setter Property="Background" Value="{StaticResource BaseBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="PanelCard" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="20"/>
    </Style>
    <Style x:Key="NavigationButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#ADBDC4"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="17,13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#253641"/>
                <Setter Property="Foreground" Value="#F1F7F7"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="#34514F"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Foreground" Value="#10221E"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="9"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="#263540"/>
      <Setter Property="Foreground" Value="#E8F1F2"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#222F39"/>
      <Setter Property="Foreground" Value="#F1F7F7"/>
      <Setter Property="BorderBrush" Value="#344653"/>
      <Setter Property="CaretBrush" Value="#9BDACB"/>
      <Setter Property="Padding" Value="10,9"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#263540"/>
      <Setter Property="Foreground" Value="#F4F8F7"/>
      <Setter Property="Padding" Value="8,6"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E8F1F2"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#18222D"/>
      <Setter Property="Foreground" Value="#ECF4F5"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="RowBackground" Value="#18222D"/>
      <Setter Property="AlternatingRowBackground" Value="#1D2934"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#2A3844"/>
      <Setter Property="VerticalGridLinesBrush" Value="#2A3844"/>
      <Setter Property="GridLinesVisibility" Value="None"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="CanUserResizeRows" Value="False"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="RowHeight" Value="42"/>
      <Setter Property="ColumnHeaderHeight" Value="38"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#222F39"/>
      <Setter Property="Foreground" Value="#B5C8CD"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#EAF1F3"/>
      <Setter Property="Padding" Value="10,0"/>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="#18222D"/>
      <Setter Property="Foreground" Value="#EAF1F3"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#295449"/>
          <Setter Property="Foreground" Value="#FFFFFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Background" Value="#32424E"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
  </Application.Resources>
</Application>
